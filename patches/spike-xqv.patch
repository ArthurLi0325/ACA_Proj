@@ -190,6 +245,8 @@ class xqmac_t : public extension_t
       new disasm_insn_t("qacc.row", 0x0000502b, 0xfe00707f, {&xq_rs1}),
       new disasm_insn_t("qacc.rq",  0x0000302b, 0xfc00707f, {&xq_rd, &xq_rs1}),
       new disasm_insn_t("qacc.rqa", 0x0000402b, 0xfc00707f, {&xq_rd, &xq_rs1}),
+      new disasm_insn_t("vqdot4.vx", 0x0000005b, 0xfe00707f, {&xq_vd, &xq_rs1, &xq_vs2}),
+      new disasm_insn_t("vqdot8.vx", 0x0000105b, 0xfe00707f, {&xq_vd, &xq_rs1, &xq_vs2}),
     };
   }
